# Server-only secrets
OPENAI_API_KEY=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Public origins. The native bundle uses NEXT_PUBLIC_API_ORIGIN for AI,
# friend sync, and APNs token registration.
NEXT_PUBLIC_SITE_URL=https://your-web-app.example
NEXT_PUBLIC_API_ORIGIN=https://your-web-app.example

# Optional build-only alias used by `npm run cap:build`.
CAPACITOR_API_ORIGIN=https://your-web-app.example

# Apple Push Notification service (APNs). Store the .p8 contents with literal
# \n escapes when your host does not support multiline environment values.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.melonmate.app
APNS_PRODUCTION=false
PUSH_ADMIN_SECRET=
